{
  "$defs": {
    "ActorKind": {
      "enum": [
        "human",
        "agent",
        "service",
        "workflow",
        "executor"
      ],
      "title": "ActorKind",
      "type": "string"
    },
    "ActorRef": {
      "additionalProperties": false,
      "properties": {
        "attributes": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Attributes",
          "type": "object"
        },
        "display_name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ActorKind"
        },
        "tenant_id": {
          "minLength": 1,
          "title": "Tenant Id",
          "type": "string"
        },
        "workload_identity": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workload Identity"
        }
      },
      "required": [
        "kind",
        "id",
        "tenant_id"
      ],
      "title": "ActorRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "archive_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Archive Sha256",
      "type": "string"
    },
    "bundle_manifest_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Bundle Manifest Sha256",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by": {
      "$ref": "#/$defs/ActorRef"
    },
    "legal_hold_preserved": {
      "default": true,
      "title": "Legal Hold Preserved",
      "type": "boolean"
    },
    "schema_name": {
      "default": "prodkit.evidence-transfer-manifest",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_control_version": {
      "minLength": 1,
      "title": "Source Control Version",
      "type": "string"
    },
    "source_schema_version": {
      "minimum": 1,
      "title": "Source Schema Version",
      "type": "integer"
    },
    "tenant_id": {
      "minLength": 1,
      "title": "Tenant Id",
      "type": "string"
    },
    "transfer_id": {
      "format": "uuid",
      "title": "Transfer Id",
      "type": "string"
    },
    "trust_root_revision": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Trust Root Revision"
    }
  },
  "required": [
    "transfer_id",
    "tenant_id",
    "created_at",
    "created_by",
    "source_control_version",
    "source_schema_version",
    "archive_sha256",
    "bundle_manifest_sha256"
  ],
  "title": "EvidenceTransferManifest",
  "type": "object"
}
