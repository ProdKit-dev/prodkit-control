{
  "properties": {
    "bundle_manifest_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Bundle Manifest Sha256",
      "type": "string"
    },
    "canonicalization": {
      "const": "prodkit-json-v1",
      "default": "prodkit-json-v1",
      "title": "Canonicalization",
      "type": "string"
    },
    "final_event_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Final Event Hash",
      "type": "string"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "schema_name": {
      "const": "prodkit.control-evidence-attestation",
      "default": "prodkit.control-evidence-attestation",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "tenant_id": {
      "minLength": 1,
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "tenant_id",
    "bundle_manifest_sha256",
    "final_event_hash"
  ],
  "title": "ProdKitEvidencePredicateV1",
  "type": "object"
}
