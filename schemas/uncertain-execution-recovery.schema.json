{
  "$defs": {
    "ExecutionAttemptState": {
      "enum": [
        "claimed",
        "started",
        "succeeded",
        "failed",
        "uncertain"
      ],
      "title": "ExecutionAttemptState",
      "type": "string"
    },
    "UncertainRecoveryDisposition": {
      "enum": [
        "reconcile_required",
        "matched_success",
        "matched_failure",
        "not_observed",
        "unverifiable"
      ],
      "title": "UncertainRecoveryDisposition",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action_id": {
      "format": "uuid",
      "title": "Action Id",
      "type": "string"
    },
    "attempt_id": {
      "format": "uuid",
      "title": "Attempt Id",
      "type": "string"
    },
    "disposition": {
      "$ref": "#/$defs/UncertainRecoveryDisposition"
    },
    "evidence_reference": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evidence Reference"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "original_state": {
      "$ref": "#/$defs/ExecutionAttemptState",
      "default": "uncertain"
    },
    "provider_operation_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Operation Id"
    },
    "recovery_id": {
      "format": "uuid",
      "title": "Recovery Id",
      "type": "string"
    },
    "replay_permitted": {
      "default": false,
      "title": "Replay Permitted",
      "type": "boolean"
    },
    "restore_id": {
      "format": "uuid",
      "title": "Restore Id",
      "type": "string"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "schema_name": {
      "default": "prodkit.uncertain-execution-recovery",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "tenant_id": {
      "minLength": 1,
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "recovery_id",
    "restore_id",
    "tenant_id",
    "attempt_id",
    "action_id",
    "run_id",
    "disposition",
    "observed_at"
  ],
  "title": "UncertainExecutionRecovery",
  "type": "object"
}
