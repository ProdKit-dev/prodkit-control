{
  "$defs": {
    "ActorKind": {
      "enum": [
        "human",
        "agent",
        "service",
        "workflow",
        "executor"
      ],
      "title": "ActorKind",
      "type": "string"
    },
    "ActorRef": {
      "additionalProperties": false,
      "properties": {
        "attributes": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Attributes",
          "type": "object"
        },
        "display_name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ActorKind"
        },
        "tenant_id": {
          "minLength": 1,
          "title": "Tenant Id",
          "type": "string"
        },
        "workload_identity": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workload Identity"
        }
      },
      "required": [
        "kind",
        "id",
        "tenant_id"
      ],
      "title": "ActorRef",
      "type": "object"
    },
    "BreakGlassCapability": {
      "enum": [
        "restore",
        "failover",
        "integrity_scan",
        "reconcile",
        "configure_recovery"
      ],
      "title": "BreakGlassCapability",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "approved_by": {
      "$ref": "#/$defs/ActorRef"
    },
    "capabilities": {
      "items": {
        "$ref": "#/$defs/BreakGlassCapability"
      },
      "title": "Capabilities",
      "type": "array"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "grant_id": {
      "format": "uuid",
      "title": "Grant Id",
      "type": "string"
    },
    "issued_at": {
      "format": "date-time",
      "title": "Issued At",
      "type": "string"
    },
    "operator": {
      "$ref": "#/$defs/ActorRef"
    },
    "reason": {
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "schema_name": {
      "default": "prodkit.break-glass-grant",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "tenant_id": {
      "minLength": 1,
      "title": "Tenant Id",
      "type": "string"
    },
    "ticket_reference": {
      "minLength": 1,
      "title": "Ticket Reference",
      "type": "string"
    }
  },
  "required": [
    "grant_id",
    "tenant_id",
    "operator",
    "approved_by",
    "capabilities",
    "reason",
    "ticket_reference",
    "issued_at",
    "expires_at"
  ],
  "title": "BreakGlassGrant",
  "type": "object"
}
