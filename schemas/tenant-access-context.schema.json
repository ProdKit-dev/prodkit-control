{
  "$defs": {
    "ActorKind": {
      "enum": [
        "human",
        "agent",
        "service",
        "workflow",
        "executor"
      ],
      "title": "ActorKind",
      "type": "string"
    },
    "ActorRef": {
      "additionalProperties": false,
      "properties": {
        "attributes": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Attributes",
          "type": "object"
        },
        "display_name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ActorKind"
        },
        "tenant_id": {
          "minLength": 1,
          "title": "Tenant Id",
          "type": "string"
        },
        "workload_identity": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workload Identity"
        }
      },
      "required": [
        "kind",
        "id",
        "tenant_id"
      ],
      "title": "ActorRef",
      "type": "object"
    },
    "TenantAccessMode": {
      "enum": [
        "tenant",
        "support"
      ],
      "title": "TenantAccessMode",
      "type": "string"
    },
    "TenantCapability": {
      "enum": [
        "read",
        "write",
        "execute",
        "approve",
        "export",
        "delete",
        "legal_hold",
        "configure"
      ],
      "title": "TenantCapability",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Authoritative tenant context carried across service and adapter boundaries.",
  "properties": {
    "actor": {
      "$ref": "#/$defs/ActorRef"
    },
    "capabilities": {
      "default": [],
      "items": {
        "$ref": "#/$defs/TenantCapability"
      },
      "title": "Capabilities",
      "type": "array"
    },
    "elevation_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Elevation Id"
    },
    "expires_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expires At"
    },
    "issued_at": {
      "format": "date-time",
      "title": "Issued At",
      "type": "string"
    },
    "mode": {
      "$ref": "#/$defs/TenantAccessMode",
      "default": "tenant"
    },
    "reason": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    },
    "schema_name": {
      "default": "prodkit.tenant-access-context",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "tenant_id": {
      "minLength": 1,
      "title": "Tenant Id",
      "type": "string"
    },
    "ticket_reference": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ticket Reference"
    }
  },
  "required": [
    "tenant_id",
    "actor",
    "issued_at"
  ],
  "title": "TenantAccessContext",
  "type": "object"
}
