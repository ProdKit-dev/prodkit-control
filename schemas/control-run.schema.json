{
  "$defs": {
    "ActorKind": {
      "enum": [
        "human",
        "agent",
        "service",
        "workflow",
        "executor"
      ],
      "title": "ActorKind",
      "type": "string"
    },
    "ActorRef": {
      "additionalProperties": false,
      "properties": {
        "attributes": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Attributes",
          "type": "object"
        },
        "display_name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ActorKind"
        },
        "tenant_id": {
          "minLength": 1,
          "title": "Tenant Id",
          "type": "string"
        },
        "workload_identity": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workload Identity"
        }
      },
      "required": [
        "kind",
        "id",
        "tenant_id"
      ],
      "title": "ActorRef",
      "type": "object"
    },
    "LineageNodeKind": {
      "enum": [
        "specification_revision",
        "decision_set",
        "generator_configuration",
        "source_tree",
        "verification",
        "build_artifact",
        "authorization",
        "agent_action",
        "deployment",
        "production_observation",
        "reconciliation"
      ],
      "title": "LineageNodeKind",
      "type": "string"
    },
    "LineageNodeRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/LineageNodeKind"
        },
        "node_id": {
          "format": "uuid",
          "title": "Node Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "node_id",
        "digest"
      ],
      "title": "LineageNodeRef",
      "type": "object"
    },
    "RunStatus": {
      "enum": [
        "pending",
        "running",
        "waiting_for_approval",
        "succeeded",
        "failed",
        "cancelled",
        "incomplete"
      ],
      "title": "RunStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    },
    "environment": {
      "minLength": 1,
      "title": "Environment",
      "type": "string"
    },
    "initiated_by": {
      "$ref": "#/$defs/ActorRef"
    },
    "lineage_graph_digest": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lineage Graph Digest"
    },
    "metadata": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Metadata",
      "type": "object"
    },
    "purpose": {
      "minLength": 1,
      "title": "Purpose",
      "type": "string"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "schema_name": {
      "default": "prodkit.control-run",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_intent_digest": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Intent Digest"
    },
    "specification_revision": {
      "anyOf": [
        {
          "$ref": "#/$defs/LineageNodeRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/RunStatus"
    },
    "tenant_id": {
      "minLength": 1,
      "title": "Tenant Id",
      "type": "string"
    },
    "trace_id": {
      "minLength": 1,
      "title": "Trace Id",
      "type": "string"
    },
    "workflow_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Workflow Id"
    }
  },
  "required": [
    "run_id",
    "tenant_id",
    "status",
    "initiated_by",
    "environment",
    "purpose",
    "trace_id",
    "started_at"
  ],
  "title": "RunRecord",
  "type": "object"
}
