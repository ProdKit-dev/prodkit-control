{
  "$defs": {
    "ActorKind": {
      "enum": [
        "human",
        "agent",
        "service",
        "workflow",
        "executor"
      ],
      "title": "ActorKind",
      "type": "string"
    },
    "ActorRef": {
      "additionalProperties": false,
      "properties": {
        "attributes": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Attributes",
          "type": "object"
        },
        "display_name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ActorKind"
        },
        "tenant_id": {
          "minLength": 1,
          "title": "Tenant Id",
          "type": "string"
        },
        "workload_identity": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workload Identity"
        }
      },
      "required": [
        "kind",
        "id",
        "tenant_id"
      ],
      "title": "ActorRef",
      "type": "object"
    },
    "ExecutionAttemptState": {
      "enum": [
        "claimed",
        "started",
        "succeeded",
        "failed",
        "uncertain"
      ],
      "title": "ExecutionAttemptState",
      "type": "string"
    },
    "RestoreStatus": {
      "enum": [
        "verified",
        "degraded",
        "failed"
      ],
      "title": "RestoreStatus",
      "type": "string"
    },
    "UncertainExecutionRecovery": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "format": "uuid",
          "title": "Action Id",
          "type": "string"
        },
        "attempt_id": {
          "format": "uuid",
          "title": "Attempt Id",
          "type": "string"
        },
        "disposition": {
          "$ref": "#/$defs/UncertainRecoveryDisposition"
        },
        "evidence_reference": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Reference"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "original_state": {
          "$ref": "#/$defs/ExecutionAttemptState",
          "default": "uncertain"
        },
        "provider_operation_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Operation Id"
        },
        "recovery_id": {
          "format": "uuid",
          "title": "Recovery Id",
          "type": "string"
        },
        "replay_permitted": {
          "default": false,
          "title": "Replay Permitted",
          "type": "boolean"
        },
        "restore_id": {
          "format": "uuid",
          "title": "Restore Id",
          "type": "string"
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "schema_name": {
          "default": "prodkit.uncertain-execution-recovery",
          "title": "Schema Name",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "tenant_id": {
          "minLength": 1,
          "title": "Tenant Id",
          "type": "string"
        }
      },
      "required": [
        "recovery_id",
        "restore_id",
        "tenant_id",
        "attempt_id",
        "action_id",
        "run_id",
        "disposition",
        "observed_at"
      ],
      "title": "UncertainExecutionRecovery",
      "type": "object"
    },
    "UncertainRecoveryDisposition": {
      "enum": [
        "reconcile_required",
        "matched_success",
        "matched_failure",
        "not_observed",
        "unverifiable"
      ],
      "title": "UncertainRecoveryDisposition",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "actual_rpo_seconds": {
      "minimum": 0,
      "title": "Actual Rpo Seconds",
      "type": "number"
    },
    "actual_rto_seconds": {
      "minimum": 0,
      "title": "Actual Rto Seconds",
      "type": "number"
    },
    "backup_id": {
      "format": "uuid",
      "title": "Backup Id",
      "type": "string"
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    },
    "completed_by": {
      "$ref": "#/$defs/ActorRef"
    },
    "integrity_scan_id": {
      "format": "uuid",
      "title": "Integrity Scan Id",
      "type": "string"
    },
    "promoted": {
      "default": false,
      "title": "Promoted",
      "type": "boolean"
    },
    "restore_id": {
      "format": "uuid",
      "title": "Restore Id",
      "type": "string"
    },
    "schema_name": {
      "default": "prodkit.restore-result",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/RestoreStatus"
    },
    "tenant_id": {
      "minLength": 1,
      "title": "Tenant Id",
      "type": "string"
    },
    "uncertain_recoveries": {
      "default": [],
      "items": {
        "$ref": "#/$defs/UncertainExecutionRecovery"
      },
      "title": "Uncertain Recoveries",
      "type": "array"
    }
  },
  "required": [
    "restore_id",
    "tenant_id",
    "backup_id",
    "started_at",
    "completed_at",
    "status",
    "actual_rpo_seconds",
    "actual_rto_seconds",
    "integrity_scan_id",
    "completed_by"
  ],
  "title": "RestoreResult",
  "type": "object"
}
