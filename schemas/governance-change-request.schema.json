{
  "$defs": {
    "ActorKind": {
      "enum": [
        "human",
        "agent",
        "service",
        "workflow",
        "executor"
      ],
      "title": "ActorKind",
      "type": "string"
    },
    "ActorRef": {
      "additionalProperties": false,
      "properties": {
        "attributes": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Attributes",
          "type": "object"
        },
        "display_name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ActorKind"
        },
        "tenant_id": {
          "minLength": 1,
          "title": "Tenant Id",
          "type": "string"
        },
        "workload_identity": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workload Identity"
        }
      },
      "required": [
        "kind",
        "id",
        "tenant_id"
      ],
      "title": "ActorRef",
      "type": "object"
    },
    "GovernanceChangeStatus": {
      "enum": [
        "proposed",
        "approved",
        "rejected",
        "applied",
        "cancelled"
      ],
      "title": "GovernanceChangeStatus",
      "type": "string"
    },
    "GovernanceRisk": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "GovernanceRisk",
      "type": "string"
    },
    "GovernanceTargetType": {
      "enum": [
        "retention_policy",
        "trust_root_policy",
        "legal_hold_release",
        "tenant_configuration",
        "compatibility_policy",
        "deprecation_policy"
      ],
      "title": "GovernanceTargetType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "applied_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Applied At"
    },
    "approved_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Approved At"
    },
    "approved_by": {
      "anyOf": [
        {
          "$ref": "#/$defs/ActorRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "expected_current_digest": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Current Digest"
    },
    "proposed_at": {
      "format": "date-time",
      "title": "Proposed At",
      "type": "string"
    },
    "proposed_by": {
      "$ref": "#/$defs/ActorRef"
    },
    "proposed_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Proposed Digest",
      "type": "string"
    },
    "reason": {
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "risk": {
      "$ref": "#/$defs/GovernanceRisk"
    },
    "schema_name": {
      "default": "prodkit.governance-change-request",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/GovernanceChangeStatus",
      "default": "proposed"
    },
    "target_id": {
      "minLength": 1,
      "title": "Target Id",
      "type": "string"
    },
    "target_type": {
      "$ref": "#/$defs/GovernanceTargetType"
    },
    "tenant_id": {
      "minLength": 1,
      "title": "Tenant Id",
      "type": "string"
    },
    "ticket_reference": {
      "minLength": 1,
      "title": "Ticket Reference",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "tenant_id",
    "target_type",
    "target_id",
    "proposed_digest",
    "risk",
    "reason",
    "ticket_reference",
    "proposed_at",
    "proposed_by"
  ],
  "title": "GovernanceChangeRequest",
  "type": "object"
}
