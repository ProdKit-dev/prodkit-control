    "ReconciliationSourceHealth": {
      "enum": [
        "healthy",
        "stale",
        "unavailable",
        "conflicting"
      ],
      "title": "ReconciliationSourceHealth",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "audit_events": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ExternalAuditEvent"
      },
      "title": "Audit Events",
      "type": "array"
    },
    "collected_at": {
      "format": "date-time",
      "title": "Collected At",
      "type": "string"
    },
    "cursor": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cursor"
    },
    "health": {
      "$ref": "#/$defs/ReconciliationSourceHealth"
    },
    "high_watermark": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "High Watermark"
    },
    "observations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ExternalStateObservation"
      },
      "title": "Observations",
      "type": "array"
    },
    "source_system": {
      "minLength": 1,
      "title": "Source System",
      "type": "string"
    },
    "tenant_id": {
      "minLength": 1,
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "source_system",
    "collected_at",
    "health"
  ],
  "title": "ReconciliationBatch",
  "type": "object"
}
