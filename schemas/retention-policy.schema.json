{
  "$defs": {
    "ActorKind": {
      "enum": [
        "human",
        "agent",
        "service",
        "workflow",
        "executor"
      ],
      "title": "ActorKind",
      "type": "string"
    },
    "ActorRef": {
      "additionalProperties": false,
      "properties": {
        "attributes": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Attributes",
          "type": "object"
        },
        "display_name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ActorKind"
        },
        "tenant_id": {
          "minLength": 1,
          "title": "Tenant Id",
          "type": "string"
        },
        "workload_identity": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workload Identity"
        }
      },
      "required": [
        "kind",
        "id",
        "tenant_id"
      ],
      "title": "ActorRef",
      "type": "object"
    },
    "RetentionRule": {
      "additionalProperties": false,
      "properties": {
        "deletion_allowed": {
          "default": true,
          "title": "Deletion Allowed",
          "type": "boolean"
        },
        "deletion_grace_seconds": {
          "default": 0,
          "minimum": 0,
          "title": "Deletion Grace Seconds",
          "type": "integer"
        },
        "resource_type": {
          "minLength": 1,
          "title": "Resource Type",
          "type": "string"
        },
        "retain_for_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retain For Seconds"
        }
      },
      "required": [
        "resource_type"
      ],
      "title": "RetentionRule",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by": {
      "$ref": "#/$defs/ActorRef"
    },
    "default_retain_for_seconds": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Default Retain For Seconds"
    },
    "effective_at": {
      "format": "date-time",
      "title": "Effective At",
      "type": "string"
    },
    "policy_id": {
      "format": "uuid",
      "title": "Policy Id",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "rules": {
      "items": {
        "$ref": "#/$defs/RetentionRule"
      },
      "title": "Rules",
      "type": "array"
    },
    "schema_name": {
      "default": "prodkit.retention-policy",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "tenant_id": {
      "minLength": 1,
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "policy_id",
    "tenant_id",
    "revision",
    "effective_at",
    "rules",
    "created_at",
    "created_by"
  ],
  "title": "RetentionPolicy",
  "type": "object"
}
