{
  "$defs": {
    "BackupComponentRecord": {
      "additionalProperties": false,
      "properties": {
        "captured_at": {
          "format": "date-time",
          "title": "Captured At",
          "type": "string"
        },
        "component": {
          "$ref": "#/$defs/RecoveryComponent"
        },
        "encrypted": {
          "default": true,
          "title": "Encrypted",
          "type": "boolean"
        },
        "immutable": {
          "default": true,
          "title": "Immutable",
          "type": "boolean"
        },
        "reference": {
          "minLength": 1,
          "title": "Reference",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "source_site": {
          "minLength": 1,
          "title": "Source Site",
          "type": "string"
        }
      },
      "required": [
        "component",
        "reference",
        "sha256",
        "size_bytes",
        "captured_at",
        "source_site"
      ],
      "title": "BackupComponentRecord",
      "type": "object"
    },
    "RecoveryComponent": {
      "enum": [
        "ledger",
        "lineage",
        "configuration",
        "artifact_metadata",
        "object_store",
        "idempotency",
        "execution_attempts",
        "governance"
      ],
      "title": "RecoveryComponent",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "backup_id": {
      "format": "uuid",
      "title": "Backup Id",
      "type": "string"
    },
    "components": {
      "items": {
        "$ref": "#/$defs/BackupComponentRecord"
      },
      "title": "Components",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "ledger_chain_tip_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Ledger Chain Tip Sha256",
      "type": "string"
    },
    "profile_id": {
      "minLength": 1,
      "title": "Profile Id",
      "type": "string"
    },
    "profile_revision": {
      "minimum": 1,
      "title": "Profile Revision",
      "type": "integer"
    },
    "recovery_point_at": {
      "format": "date-time",
      "title": "Recovery Point At",
      "type": "string"
    },
    "schema_name": {
      "default": "prodkit.backup-manifest",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshot_set_id": {
      "minLength": 1,
      "title": "Snapshot Set Id",
      "type": "string"
    },
    "source_control_version": {
      "minLength": 1,
      "title": "Source Control Version",
      "type": "string"
    },
    "source_schema_version": {
      "minimum": 1,
      "title": "Source Schema Version",
      "type": "integer"
    },
    "source_site": {
      "minLength": 1,
      "title": "Source Site",
      "type": "string"
    },
    "tenant_id": {
      "minLength": 1,
      "title": "Tenant Id",
      "type": "string"
    },
    "trust_anchor_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Trust Anchor Sha256",
      "type": "string"
    },
    "trusted_checkpoint_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Trusted Checkpoint Sha256",
      "type": "string"
    }
  },
  "required": [
    "backup_id",
    "tenant_id",
    "profile_id",
    "profile_revision",
    "source_schema_version",
    "source_control_version",
    "source_site",
    "snapshot_set_id",
    "recovery_point_at",
    "created_at",
    "components",
    "ledger_chain_tip_sha256",
    "trusted_checkpoint_sha256",
    "trust_anchor_sha256"
  ],
  "title": "BackupManifest",
  "type": "object"
}
