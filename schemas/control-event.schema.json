{
  "$defs": {
    "ActorKind": {
      "enum": [
        "human",
        "agent",
        "service",
        "workflow",
        "executor"
      ],
      "title": "ActorKind",
      "type": "string"
    },
    "ActorRef": {
      "additionalProperties": false,
      "properties": {
        "attributes": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Attributes",
          "type": "object"
        },
        "display_name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ActorKind"
        },
        "tenant_id": {
          "minLength": 1,
          "title": "Tenant Id",
          "type": "string"
        },
        "workload_identity": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workload Identity"
        }
      },
      "required": [
        "kind",
        "id",
        "tenant_id"
      ],
      "title": "ActorRef",
      "type": "object"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "classification": {
          "default": "internal",
          "minLength": 1,
          "title": "Classification",
          "type": "string"
        },
        "encrypted": {
          "default": false,
          "title": "Encrypted",
          "type": "boolean"
        },
        "location": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "redacted": {
          "default": false,
          "title": "Redacted",
          "type": "boolean"
        },
        "redaction_version": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Redaction Version"
        },
        "retention_until": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retention Until"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "storage_mode": {
          "$ref": "#/$defs/ContentStorageMode"
        }
      },
      "required": [
        "artifact_id",
        "media_type",
        "sha256",
        "size_bytes",
        "storage_mode"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ContentStorageMode": {
      "enum": [
        "none",
        "hash_only",
        "redacted",
        "full"
      ],
      "title": "ContentStorageMode",
      "type": "string"
    },
    "EventIntegrity": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "default": "sha256",
          "title": "Algorithm",
          "type": "string"
        },
        "canonicalization": {
          "default": "prodkit-json-v1",
          "title": "Canonicalization",
          "type": "string"
        },
        "event_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Event Hash",
          "type": "string"
        },
        "previous_event_hash": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previous Event Hash"
        },
        "signature": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Signature"
        },
        "signing_key_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Signing Key Id"
        }
      },
      "required": [
        "event_hash"
      ],
      "title": "EventIntegrity",
      "type": "object"
    },
    "EventType": {
      "enum": [
        "run.started",
        "run.completed",
        "model.requested",
        "model.responded",
        "context.accessed",
        "action.proposed",
        "policy.evaluated",
        "approval.requested",
        "approval.decided",
        "execution.started",
        "execution.completed",
        "state.observed",
        "verification.completed",
        "reconciliation.completed",
        "artifact.recorded",
        "lineage.node_recorded",
        "lineage.relation_recorded",
        "lineage.assessed",
        "rollback.started",
        "rollback.completed",
        "correction.recorded"
      ],
      "title": "EventType",
      "type": "string"
    },
    "LineageNodeKind": {
      "enum": [
        "specification_revision",
        "decision_set",
        "generator_configuration",
        "source_tree",
        "verification",
        "build_artifact",
        "authorization",
        "agent_action",
        "deployment",
        "production_observation",
        "reconciliation"
      ],
      "title": "LineageNodeKind",
      "type": "string"
    },
    "LineageNodeRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/LineageNodeKind"
        },
        "node_id": {
          "format": "uuid",
          "title": "Node Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "node_id",
        "digest"
      ],
      "title": "LineageNodeRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Action Id"
    },
    "actor": {
      "$ref": "#/$defs/ActorRef"
    },
    "causation_event_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Causation Event Id"
    },
    "correlation_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Correlation Id"
    },
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "$ref": "#/$defs/EventType"
    },
    "evidence": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Evidence",
      "type": "array"
    },
    "integrity": {
      "$ref": "#/$defs/EventIntegrity"
    },
    "lineage": {
      "default": [],
      "items": {
        "$ref": "#/$defs/LineageNodeRef"
      },
      "title": "Lineage",
      "type": "array"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "parent_event_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Event Id"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    },
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "schema_name": {
      "default": "prodkit.control-event",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "span_id": {
      "pattern": "^[a-f0-9]{16}$",
      "title": "Span Id",
      "type": "string"
    },
    "tenant_id": {
      "minLength": 1,
      "title": "Tenant Id",
      "type": "string"
    },
    "trace_id": {
      "pattern": "^[a-f0-9]{32}$",
      "title": "Trace Id",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "run_id",
    "tenant_id",
    "event_type",
    "occurred_at",
    "recorded_at",
    "actor",
    "trace_id",
    "span_id",
    "sequence",
    "integrity"
  ],
  "title": "ControlEvent",
  "type": "object"
}
