{
  "$defs": {
    "CheckpointSigningAlgorithm": {
      "enum": [
        "ed25519"
      ],
      "title": "CheckpointSigningAlgorithm",
      "type": "string"
    },
    "TrustedSigningKey": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "$ref": "#/$defs/CheckpointSigningAlgorithm",
          "default": "ed25519"
        },
        "key_id": {
          "minLength": 1,
          "title": "Key Id",
          "type": "string"
        },
        "public_key_base64": {
          "minLength": 1,
          "title": "Public Key Base64",
          "type": "string"
        },
        "revoked_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revoked At"
        },
        "signer_id": {
          "minLength": 1,
          "title": "Signer Id",
          "type": "string"
        },
        "valid_from": {
          "format": "date-time",
          "title": "Valid From",
          "type": "string"
        },
        "valid_until": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid Until"
        }
      },
      "required": [
        "key_id",
        "public_key_base64",
        "signer_id",
        "valid_from"
      ],
      "title": "TrustedSigningKey",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "allow_historical_signatures_before_revocation": {
      "default": true,
      "title": "Allow Historical Signatures Before Revocation",
      "type": "boolean"
    },
    "allowed_signers": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Allowed Signers",
      "type": "array"
    },
    "policy_id": {
      "minLength": 1,
      "title": "Policy Id",
      "type": "string"
    },
    "revision": {
      "minLength": 1,
      "title": "Revision",
      "type": "string"
    },
    "schema_name": {
      "const": "prodkit.trust-root-policy",
      "default": "prodkit.trust-root-policy",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "trusted_keys": {
      "items": {
        "$ref": "#/$defs/TrustedSigningKey"
      },
      "title": "Trusted Keys",
      "type": "array"
    }
  },
  "required": [
    "policy_id",
    "revision",
    "trusted_keys"
  ],
  "title": "TrustRootPolicy",
  "type": "object"
}
