      "type": "string"
    },
    "sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "size_bytes": {
      "minimum": 0,
      "title": "Size Bytes",
      "type": "integer"
    },
    "source_site": {
      "minLength": 1,
      "title": "Source Site",
      "type": "string"
    }
  },
  "required": [
    "component",
    "reference",
    "sha256",
    "size_bytes",
    "captured_at",
    "source_site"
