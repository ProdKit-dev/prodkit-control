{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "classification": {
          "default": "internal",
          "minLength": 1,
          "title": "Classification",
          "type": "string"
        },
        "encrypted": {
          "default": false,
          "title": "Encrypted",
          "type": "boolean"
        },
        "location": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "redacted": {
          "default": false,
          "title": "Redacted",
          "type": "boolean"
        },
        "redaction_version": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Redaction Version"
        },
        "retention_until": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retention Until"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "title": "Size Bytes",
          "type": "integer"
        },
        "storage_mode": {
          "$ref": "#/$defs/ContentStorageMode"
        },
        "tenant_id": {
          "minLength": 1,
          "title": "Tenant Id",
          "type": "string"
        }
      },
      "required": [
        "tenant_id",
        "artifact_id",
        "media_type",
        "sha256",
        "size_bytes",
        "storage_mode"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ContentStorageMode": {
      "enum": [
        "none",
        "hash_only",
        "redacted",
        "full"
      ],
      "title": "ContentStorageMode",
      "type": "string"
    },
    "ReconciliationFinding": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action Id"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "evidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Evidence",
          "type": "array"
        },
        "external_reference": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "External Reference"
        },
        "finding_id": {
          "format": "uuid",
          "title": "Finding Id",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/ReconciliationOutcome"
        },
        "reconciler": {
          "minLength": 1,
          "title": "Reconciler",
          "type": "string"
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "severity": {
          "minLength": 1,
          "title": "Severity",
          "type": "string"
        },
        "source_system": {
          "minLength": 1,
          "title": "Source System",
          "type": "string"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "finding_id",
        "run_id",
        "reconciler",
        "source_system",
        "observed_at",
        "outcome",
        "severity",
        "summary"
      ],
      "title": "ReconciliationFinding",
      "type": "object"
    },
    "ReconciliationOutcome": {
      "enum": [
        "matched",
        "missing_external_evidence",
        "unexpected_external_action",
        "state_mismatch",
        "conflicting_evidence",
        "unverifiable"
      ],
      "title": "ReconciliationOutcome",
      "type": "string"
    },
    "ReconciliationSourceHealth": {
      "enum": [
        "healthy",
        "stale",
        "unavailable",
        "conflicting"
      ],
      "title": "ReconciliationSourceHealth",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    },
    "cursor": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cursor"
    },
    "findings": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ReconciliationFinding"
      },
      "title": "Findings",
      "type": "array"
    },
    "health": {
      "$ref": "#/$defs/ReconciliationSourceHealth"
    },
    "high_watermark": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "High Watermark"
    },
    "reconciliation_id": {
      "format": "uuid",
      "title": "Reconciliation Id",
      "type": "string"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "source_system": {
      "minLength": 1,
      "title": "Source System",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "tenant_id": {
      "minLength": 1,
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "reconciliation_id",
    "run_id",
    "tenant_id",
    "source_system",
    "started_at",
    "completed_at",
    "health"
  ],
  "title": "ReconciliationRunResult",
  "type": "object"
}
