{
  "$defs": {
    "RetentionDisposition": {
      "enum": [
        "retain",
        "delete"
      ],
      "title": "RetentionDisposition",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "delete_not_before": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Delete Not Before"
    },
    "disposition": {
      "$ref": "#/$defs/RetentionDisposition"
    },
    "evaluated_at": {
      "format": "date-time",
      "title": "Evaluated At",
      "type": "string"
    },
    "legal_hold_ids": {
      "default": [],
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Legal Hold Ids",
      "type": "array"
    },
    "policy_id": {
      "format": "uuid",
      "title": "Policy Id",
      "type": "string"
    },
    "policy_revision": {
      "minimum": 1,
      "title": "Policy Revision",
      "type": "integer"
    },
    "reason": {
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "resource_id": {
      "minLength": 1,
      "title": "Resource Id",
      "type": "string"
    },
    "resource_type": {
      "minLength": 1,
      "title": "Resource Type",
      "type": "string"
    },
    "schema_name": {
      "default": "prodkit.retention-decision",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "tenant_id": {
      "minLength": 1,
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "resource_type",
    "resource_id",
    "disposition",
    "evaluated_at",
    "policy_id",
    "policy_revision",
    "reason"
  ],
  "title": "RetentionDecision",
  "type": "object"
}
