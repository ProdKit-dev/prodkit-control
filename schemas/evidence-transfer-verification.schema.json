{
  "additionalProperties": false,
  "description": "Portable evidence verification result bound to an exact transfer payload and trust anchor.",
  "properties": {
    "bundle_manifest_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Bundle Manifest Sha256",
      "type": "string"
    },
    "package_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Package Sha256",
      "type": "string"
    },
    "schema_name": {
      "default": "prodkit.evidence-transfer-verification",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_control_version": {
      "minLength": 1,
      "title": "Source Control Version",
      "type": "string"
    },
    "source_schema_version": {
      "minimum": 1,
      "title": "Source Schema Version",
      "type": "integer"
    },
    "tenant_id": {
      "minLength": 1,
      "title": "Tenant Id",
      "type": "string"
    },
    "transfer_id": {
      "format": "uuid",
      "title": "Transfer Id",
      "type": "string"
    },
    "trust_anchor_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Trust Anchor Sha256",
      "type": "string"
    },
    "verification_id": {
      "format": "uuid",
      "title": "Verification Id",
      "type": "string"
    },
    "verified_at": {
      "format": "date-time",
      "title": "Verified At",
      "type": "string"
    },
    "verified_offline": {
      "default": true,
      "title": "Verified Offline",
      "type": "boolean"
    }
  },
  "required": [
    "verification_id",
    "transfer_id",
    "tenant_id",
    "verified_at",
    "source_control_version",
    "source_schema_version",
    "package_sha256",
    "bundle_manifest_sha256",
    "trust_anchor_sha256"
  ],
  "title": "EvidenceTransferVerification",
  "type": "object"
}
