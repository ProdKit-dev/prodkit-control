{
  "$defs": {
    "ActorKind": {
      "enum": [
        "human",
        "agent",
        "service",
        "workflow",
        "executor"
      ],
      "title": "ActorKind",
      "type": "string"
    },
    "ActorRef": {
      "additionalProperties": false,
      "properties": {
        "attributes": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Attributes",
          "type": "object"
        },
        "display_name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ActorKind"
        },
        "tenant_id": {
          "minLength": 1,
          "title": "Tenant Id",
          "type": "string"
        },
        "workload_identity": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workload Identity"
        }
      },
      "required": [
        "kind",
        "id",
        "tenant_id"
      ],
      "title": "ActorRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "content_digests": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Content Digests",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "created_by": {
      "$ref": "#/$defs/ActorRef"
    },
    "elevation_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Elevation Id"
    },
    "export_id": {
      "format": "uuid",
      "title": "Export Id",
      "type": "string"
    },
    "legal_hold_preserved": {
      "default": true,
      "title": "Legal Hold Preserved",
      "type": "boolean"
    },
    "record_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Record Counts",
      "type": "object"
    },
    "schema_name": {
      "default": "prodkit.tenant-export-manifest",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "tenant_id": {
      "minLength": 1,
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "export_id",
    "tenant_id",
    "created_at",
    "created_by"
  ],
  "title": "TenantExportManifest",
  "type": "object"
}
