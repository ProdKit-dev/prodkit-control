{
  "$defs": {
    "SecurityOutcome": {
      "enum": [
        "allowed",
        "denied",
        "detected",
        "failed"
      ],
      "title": "SecurityOutcome",
      "type": "string"
    },
    "SecuritySeverity": {
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "SecuritySeverity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Action Id"
    },
    "attributes": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Attributes",
      "type": "object"
    },
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "minLength": 1,
      "title": "Event Type",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "outcome": {
      "$ref": "#/$defs/SecurityOutcome"
    },
    "principal_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Principal Id"
    },
    "request_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Request Id"
    },
    "schema_name": {
      "const": "prodkit.security-audit-event",
      "default": "prodkit.security-audit-event",
      "title": "Schema Name",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "severity": {
      "$ref": "#/$defs/SecuritySeverity"
    },
    "tenant_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tenant Id"
    }
  },
  "required": [
    "event_id",
    "occurred_at",
    "event_type",
    "severity",
    "outcome"
  ],
  "title": "SecurityAuditEvent",
  "type": "object"
}
