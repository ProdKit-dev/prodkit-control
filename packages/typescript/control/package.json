{
  "name": "@prodkit/control",
  "version": "0.8.0",
  "description": "Canonical TypeScript contracts for ProdKit Control events, lineage, and actions.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./portable": {
      "types": "./dist/portable.d.ts",
      "default": "./dist/portable.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.8.0"
  }
}
