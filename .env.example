# Development/reference API profile.
# The default API bootstrap uses in-memory services and is not the standalone durable profile.
PRODKIT_API_HOST=0.0.0.0
PRODKIT_API_PORT=8000
# Development only. Production deployments should inject an authenticated PrincipalResolver.
PRODKIT_ALLOW_INSECURE_HEADER_AUTH=false
PRODKIT_LOG_LEVEL=INFO
