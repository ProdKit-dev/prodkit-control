PRODKIT_ENVIRONMENT=development
PRODKIT_DATABASE_URL=postgresql+asyncpg://prodkit:prodkit@postgres:5432/prodkit_control
PRODKIT_ARTIFACT_ROOT=/var/lib/prodkit/artifacts
PRODKIT_API_HOST=0.0.0.0
PRODKIT_API_PORT=8000
PRODKIT_REQUIRE_AUTH=false
PRODKIT_LOG_LEVEL=INFO
OTEL_SERVICE_NAME=prodkit-control
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
